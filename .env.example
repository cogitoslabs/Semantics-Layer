# ==============================================================================
# build (CorpusBuildConfig)
# ==============================================================================
# Provide a comma-separated list of your GPU IDs, for example: 0,1,2,3
AVAILABLE_GPUS=0

# Number of files to process simultaneously per GPU
WORKERS_PER_GPU=1

# Number of files to process simultaneously per worker/GPU
CHUNK_SIZE=10

# Docling Output Path
OUTPUT_PATH=./outputs/domain_dapt_corpus.jsonl

# Optimization & Resource Settings
# GPU (e.g. RTX 3090): Set MAX_TASKS_PER_CHILD=None to prevent worker recycling.
# This avoids reloading the heavy Docling models from scratch repeatedly.
# CPU: Set MAX_TASKS_PER_CHILD=None to avoid slow CPU-based PyTorch initialization overhead.
MAX_TASKS_PER_CHILD=None

# Number of CPU threads used per worker process for layout analysis.
# When running multiple workers (e.g. WORKERS_PER_GPU > 1), set this to 1 or 2 to avoid CPU core oversubscription.
DOCLING_NUM_THREADS=2

# Docling Parser Feature Extraction Options
# Disabling these features speeds up extraction by 5x-20x.
# For GPU: Disable OCR (DOCLING_USE_OCR=False) and table extraction (DOCLING_USE_TABLE_STRUCTURE=False)
# unless you specifically have scanned PDFs or require table content layout recovery.
# For CPU: Keep all options below set to False, as deep learning extractors are extremely slow on CPU.
DOCLING_USE_OCR=False
DOCLING_USE_TABLE_STRUCTURE=False
DOCLING_USE_CODE_ENRICHMENT=False
DOCLING_USE_FORMULA_ENRICHMENT=False
DOCLING_USE_PICTURE_CLASSIFICATION=False
DOCLING_USE_PICTURE_DESCRIPTION=False


# ==============================================================================
# corpus (CorpusConfig)
# ==============================================================================
# TOTAL_CORPUS_TOKENS=30000000000 # Deprecated: Dynamically detected from pre-tokenized binary at runtime
MAX_CORPUS_PASSES=3
EVAL_INTERVAL_TOKENS=500000000
SLOW_EVAL_INTERVAL_TOKENS=250000000


# ==============================================================================
# gates (GateConfig)
# ==============================================================================
# Convergence Gate Thresholds
QA_ACC_THRESHOLD=0.55
PPL_IMPROVEMENT_THRESHOLD=2.0
PPL_PLATEAU_WINDOW=2
CLOZE_THRESHOLD=0.30
CONCEPT_THRESHOLD=0.50
QA_LOW_THRESHOLD=0.40


# ==============================================================================
# probes (ProbeConfig)
# ==============================================================================
# Evaluation Probe Activation Toggles
RUN_PERPLEXITY_PROBE=True
RUN_QA_PROBE=True
RUN_CLOZE_PROBE=True
RUN_CONCEPT_PROBE=True

# Probe 1 - Perplexity probe
# If not specified, defaults to MAX_SEQ_LEN and EVAL_BATCH_SIZE
PERPLEXITY_MAX_SEQ_LEN=
PERPLEXITY_BATCH_SIZE=

# Probe 2 - QA probe
# If not specified, QA_BATCH_SIZE defaults to EVAL_BATCH_SIZE
QA_MAX_SEQ_LEN=512
QA_BATCH_SIZE=

# Probe 3 - Cloze probe
# Top K options to generate for the cloze task
CLOZE_TOP_K=5
# Maximum number of tokens to generate for terminology cloze (defaults to 3)
CLOZE_MAX_NEW_TOKENS=3
# Batch size for terminology cloze response generation
CLOZE_GEN_BATCH_SIZE=16
# Truncation limit for prompts in terminology cloze (defaults to 256)
CLOZE_MAX_SEQ_LEN=256

# Probe 4 - Concept Probe
# SciBERT or other BERTScore checkpoint type
BERTSCORE_MODEL=allenai/scibert_scivocab_uncased
# Maximum tokens to generate for retrieval prompt (defaults to 100)
CONCEPT_MAX_NEW_TOKENS=50
# Batch size for retrieval generation
CONCEPT_GEN_BATCH_SIZE=16
# Truncation limit for prompts in retrieval probe (defaults to 256)
CONCEPT_MAX_SEQ_LEN=256
# Batch size for BERTScore model computation
CONCEPT_BERTSCORE_BATCH_SIZE=32

# PPL eval corpus size
# Number of tokens to evaluate perplexity on (defaults to 10_000_000)
PERPLEXITY_EVAL_TOKENS=200000



# ==============================================================================
# data (DataConfig)
# ==============================================================================
QA_PROBE_PATH=evals/dapt/probe_qa.jsonl
PPL_CORPUS_PATH=evals/dapt/ppl_held_out.txt
CLOZE_SET_PATH=evals/dapt/vocab_cloze_set.json
CONCEPT_PROMPTS_PATH=evals/dapt/retrieval_prompts.json
CONCEPT_REFERENCES_PATH=evals/dapt/retrieval_references.json
PRETOKENIZED_BIN_PATH=data/dapt/train_tokens.npy


# ==============================================================================
# model (ModelConfig)
# ==============================================================================
BASE_MODEL_NAME=Qwen/Qwen3-0.6B
MODEL_DTYPE=bfloat16
MAX_SEQ_LEN=512
TORCH_COMPILE=True

# PEFT-DAPT toggle and parameters
PEFT_DAPT=False
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
LORA_TARGET_MODULES=q_proj,v_proj,k_proj,o_proj
GRADIENT_CHECKPOINTING=False

# Checkpoint settings
CHECKPOINT_DIR=models/checkpoints
BEST_CHECKPOINT_MANIFEST=logs/best_checkpoint.json
CHECKPOINT_KEEP_LAST=5
# Set to True to save optimizer state dict in DAPT checkpoints (defaults to False to save disk writes/time)
SAVE_OPTIMIZER_STATE=False
# Set to True to resume DAPT training from the latest checkpoint if interrupted
RESTART_TRAINING_FROM_CHECKPOINT=False



# ==============================================================================
# optimizer (OptimizerConfig)
# ==============================================================================
DAPT_LR=5e-5
WEIGHT_DECAY=0.01
WARMUP_STEPS=1000
MAX_GRAD_NORM=1.0
TRAIN_BATCH_SIZE=2
EVAL_BATCH_SIZE=4
GRADIENT_ACCUMULATION_STEPS=1


# ==============================================================================
# storage (StorageConfig)
# ==============================================================================
# Storage Target (Choose between: local, windows, s3)
STORAGE_TARGET=local

# Local storage configuration (mount Google Drive here if running in Colab)
LOCAL_DIRECTORY_PATH=./data/raw

# AWS configuration
AWS_BUCKET_NAME=xxx
AWS_PREFIX=corpus/


# ==============================================================================
# logging (LoggingConfig)
# ==============================================================================
LOG_DIR=logs
METRICS_LOG_FILE=logs/dapt_eval_metrics.jsonl
EVAL_TRACES_FILE=logs/dapt_eval_traces.csv
MODEL_TRACING=False
MODEL_TRACE_FILE=logs/dapt_model_traces.csv
RISK_REPORT_PATH=logs/dapt_hard_cap_risk_report.json
LOG_LEVEL=INFO
LOG_FILE=pipeline.log


# ==============================================================================
# misc (MiscConfig)
# ==============================================================================
SEED=42
HF_HUB_DISABLE_SYMLINKS_WARNING=1


# ==============================================================================
# wandb (WandbConfig)
# ==============================================================================
# Weights & Biases configuration
WANDB_ENABLED=False
WANDB_API_KEY=your_api_key_here
WANDB_PROJECT=semantics-dapt
# WANDB_ENTITY=
# WANDB_RUN_NAME=
WANDB_LOG_INTERVAL_STEPS=10


# ==============================================================================
# rad (RADPrepConfig)
# ==============================================================================
# Corpus paths
RAD_CORPUS_PATH=data/rad_prep/retrieval_corpus.jsonl
RAD_CHUNKS_PATH=data/rad_prep/chunks.jsonl
RAD_INDEX_DIR=data/rad_prep/index
RAD_TRACES_DIR=data/rad_prep/traces
RAD_QA_SAMPLES_PATH=evals/dapt/probe_qa.jsonl

# Retrieval settings
# Embedding model key: biolinkbert | pubmedbert | hybrid
RAD_EMBEDDING_MODEL=biolinkbert
# Retrieval mode: dense | sparse | hybrid
RAD_RETRIEVAL_MODE=hybrid
RAD_TOP_K=7
RAD_RELEVANCE_THRESHOLD=0.65
RAD_EMBED_BATCH_SIZE=256

# Chunking token sizes
RAD_LONG_FORM_CHUNK_TOKENS=512
RAD_LONG_FORM_OVERLAP_TOKENS=64
RAD_ABSTRACT_CHUNK_TOKENS=256
RAD_ABSTRACT_OVERLAP_TOKENS=32

# Teacher model
# Backend: hf_local | api | bedrock
RAD_TEACHER_BACKEND=hf_local
# RAD_TEACHER_BACKEND=api
# RAD_TEACHER_BACKEND=bedrock
RAD_TEACHER_MODEL_NAME=Qwen/Qwen3-1.7B
# For Bedrock, model name must be a valid Bedrock model ID, e.g. meta.llama3-70b-instruct-v1:0
# RAD_TEACHER_MODEL_NAME=meta.llama3-70b-instruct-v1:0
# RAD_TEACHER_API_URL=
# RAD_TEACHER_API_KEY=
# AWS_DEFAULT_REGION=us-east-1
RAD_TEACHER_MAX_NEW_TOKENS=1024
RAD_TEACHER_BATCH_SIZE=16

# Trace filtering
RAD_TRACE_MIN_TOKENS=15
RAD_TRACE_MAX_TOKENS=2500
RAD_MIN_TRACES=1000


# ==============================================================================
# clustering (ClusteringConfig)
# ==============================================================================
# Input DAPT corpus path
CLUSTERING_CORPUS_PATH=data/dapt/domain_dapt_corpus.jsonl

# SentenceTransformer embedding settings
CLUSTERING_EMBEDDING_MODEL=all-mpnet-base-v2
CLUSTERING_EMBED_BATCH_SIZE=64
CLUSTERING_EMBEDDINGS_CACHE=data/clustering/embeddings.npy
CLUSTERING_DOC_IDS_CACHE=data/clustering/doc_ids.json

# HDBSCAN parameters
HDBSCAN_MIN_CLUSTER_SIZE=10
HDBSCAN_MIN_SAMPLES=5
HDBSCAN_METRIC=cosine

# PCA Pre-processing for HDBSCAN (to prevent distance concentration)
CLUSTERING_USE_PCA=True
CLUSTERING_PCA_COMPONENTS=10

# Noise assignment mode: nearest | drop
CLUSTERING_NOISE_ASSIGNMENT=nearest

# Reweight cap fraction thresholds
CLUSTER_MIN_FRACTION=0.02
CLUSTER_MAX_FRACTION=0.15

# Per-cluster split ratios (must sum to 1.0)
SPLIT_DEV_RATIO=0.70
SPLIT_VAL_RATIO=0.20
SPLIT_SEALED_RATIO=0.10

# Output paths
CLUSTERING_OUTPUT_DIR=data/clustering
CLUSTERING_ASSIGNMENTS_PATH=data/clustering/cluster_assignments.jsonl
CLUSTERING_SPLITS_PATH=data/clustering/splits.json
CLUSTERING_MANIFEST_PATH=data/clustering/cluster_manifest.json
CLUSTERING_REPORT_PATH=logs/clustering/cluster_report.json
CLUSTERING_MIN_CLUSTERS=10


# ==============================================================================
# benchmarking (TeacherBenchmarkingConfig)
# ==============================================================================
# Candidate teachers (comma-separated list)
BENCHMARK_TEACHERS=Qwen/Qwen3-1.7B
BENCHMARK_TEACHER_BATCH_SIZE=4

# LLM reasoning judge configuration
BENCHMARK_JUDGE_BACKEND=api
BENCHMARK_JUDGE_MODEL=meta-llama/Llama-3-70b-instruct
# BENCHMARK_JUDGE_API_URL=
# BENCHMARK_JUDGE_API_KEY=
BENCHMARK_JUDGE_MAX_NEW_TOKENS=256

# Evaluation sampler limits
BENCHMARK_EVAL_SAMPLE_SIZE=200
BENCHMARK_MIN_EVAL_SAMPLES=10

# Human calibration & Cohen's Kappa checks
BENCHMARK_ENABLE_CALIBRATION=False
BENCHMARK_CALIBRATION_SIZE=200
# BENCHMARK_HUMAN_LABELS_PATH=

# Metric scoring thresholds
BENCHMARK_HALLUCINATION_NLI_THRESHOLD=0.5
BENCHMARK_CITATION_MIN_OVERLAP=0.30
BENCHMARK_NLI_MODEL=cross-encoder/nli-deberta-v3-small

# Outputs
BENCHMARKING_OUTPUT_DIR=data/benchmarking
BENCHMARKING_SCORES_PATH=data/benchmarking/scores.jsonl
BENCHMARKING_MANIFEST_PATH=data/benchmarking/benchmark_manifest.json
BENCHMARKING_CALIBRATION_LOG=logs/benchmarking/judge_calibration.jsonl
BENCHMARKING_INTER_RATER_LOG=logs/benchmarking/inter_rater_agreement.json
