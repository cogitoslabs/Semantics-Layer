# ==============================================================================
# Step 1 — Corpus Construction (S1)
# ==============================================================================

# Storage Target (Choose between: local, windows, s3, gdrive)
STORAGE_TARGET=local

# Local storage configuration
LOCAL_DIRECTORY_PATH=./data/raw
OUTPUT_PATH=./outputs/domain_dapt_corpus.jsonl

# AWS configuration
AWS_BUCKET_NAME=xxx
AWS_PREFIX=corpus/

# Google Drive configuration
GDRIVE_FOLDER_ID=xxx

# Hardware acceleration settings
# Provide a comma-separated list of your GPU IDs, for example: 0,1,2,3
AVAILABLE_GPUS=0
# Number of files to process simultaneously per GPU
WORKERS_PER_GPU=1
CHUNK_SIZE=10


# ==============================================================================
# Step 2 — Domain Adaptive Pretraining (S2)
# ==============================================================================

# Corpus Config
TOTAL_CORPUS_TOKENS=30000000000
MAX_CORPUS_PASSES=3
EVAL_INTERVAL_TOKENS=500000000

# Model Config
BASE_MODEL_NAME=Qwen/Qwen3-0.6B
MODEL_DTYPE=bfloat16
MAX_SEQ_LEN=512

# Data pathways
PROBE_QA_PATH=evals/dapt/probe_qa.jsonl
PPL_CORPUS_PATH=evals/dapt/ppl_held_out.txt
VOCAB_CLOZE_PATH=evals/dapt/vocab_cloze_set.json
RETRIEVAL_PROMPTS_PATH=evals/dapt/retrieval_prompts.json
RETRIEVAL_REFERENCES_PATH=evals/dapt/retrieval_references.json

# Optimizer Config
DAPT_LR=5e-5
WEIGHT_DECAY=0.01
WARMUP_STEPS=1000
MAX_GRAD_NORM=1.0
TRAIN_BATCH_SIZE=2
EVAL_BATCH_SIZE=4

# Convergence Gate Thresholds
QA_ACC_THRESHOLD=0.55
PPL_IMPROVEMENT_THRESHOLD=2.0
PPL_PLATEAU_WINDOW=2
TERM_COV_THRESHOLD=0.80
RET_PREC_THRESHOLD=0.60
QA_LOW_THRESHOLD=0.40

# Evaluation Probes Settings
TERM_COV_TOP_K=5
TERM_COV_MAX_NEW_TOKENS=3
TERM_COV_GEN_BATCH_SIZE=16
BERTSCORE_MODEL=allenai/scibert_scivocab_uncased
RET_PREC_MAX_NEW_TOKENS=100
RET_PREC_GEN_BATCH_SIZE=16
PERPLEXITY_EVAL_TOKENS=10000000

# Logging & Checkpoint Storage
CHECKPOINT_DIR=models/checkpoints
LOG_DIR=logs
METRICS_LOG_FILE=logs/dapt_eval_metrics.jsonl
BEST_CHECKPOINT_MANIFEST=logs/best_checkpoint.json
RISK_REPORT_PATH=logs/dapt_hard_cap_risk_report.json
CHECKPOINT_KEEP_LAST=5

# Weights & Biases configuration
WANDB_ENABLED=False
WANDB_API_KEY=your_api_key_here
WANDB_PROJECT=semantics-dapt
# WANDB_ENTITY=
# WANDB_RUN_NAME=
WANDB_LOG_INTERVAL_STEPS=10

# Misc Settings
SEED=42
LOG_LEVEL=INFO
HF_HUB_DISABLE_SYMLINKS_WARNING=1


# ==============================================================================
# Step 3 — Retrieval-Augmented Distillation Preparation (S3)
# ==============================================================================

# Corpus paths
RAD_CORPUS_PATH=data/rad_prep/retrieval_corpus.jsonl
RAD_CHUNKS_PATH=data/rad_prep/chunks.jsonl
RAD_INDEX_DIR=data/rad_prep/index
RAD_TRACES_DIR=data/rad_prep/traces
RAD_QA_SAMPLES_PATH=evals/dapt/probe_qa.jsonl

# Retrieval settings
# Embedding model key: biolinkbert | pubmedbert | hybrid
RAD_EMBEDDING_MODEL=biolinkbert
# Retrieval mode: dense | sparse | hybrid
RAD_RETRIEVAL_MODE=hybrid
RAD_TOP_K=7
RAD_RELEVANCE_THRESHOLD=0.65
RAD_EMBED_BATCH_SIZE=64

# Chunking token sizes
RAD_LONG_FORM_CHUNK_TOKENS=512
RAD_LONG_FORM_OVERLAP_TOKENS=64
RAD_ABSTRACT_CHUNK_TOKENS=256
RAD_ABSTRACT_OVERLAP_TOKENS=32

# Teacher model
# Backend: hf_local | api | bedrock
RAD_TEACHER_BACKEND=hf_local
# RAD_TEACHER_BACKEND=api
# RAD_TEACHER_BACKEND=bedrock
RAD_TEACHER_MODEL_NAME=Qwen/Qwen3-1.7B
# For Bedrock, model name must be a valid Bedrock model ID, e.g. meta.llama3-70b-instruct-v1:0
# RAD_TEACHER_MODEL_NAME=meta.llama3-70b-instruct-v1:0
# RAD_TEACHER_API_URL=
# RAD_TEACHER_API_KEY=
# AWS_DEFAULT_REGION=us-east-1
RAD_TEACHER_MAX_NEW_TOKENS=1024
RAD_TEACHER_BATCH_SIZE=4

# Trace filtering
RAD_TRACE_MIN_TOKENS=200
RAD_TRACE_MAX_TOKENS=2500
RAD_MIN_TRACES=1000


# ==============================================================================
# Step 4 — Corpus Engineering & Micro-Clustering (S4)
# ==============================================================================

# Input DAPT corpus path
CLUSTERING_CORPUS_PATH=data/dapt/domain_dapt_corpus.jsonl

# SentenceTransformer embedding settings
CLUSTERING_EMBEDDING_MODEL=all-mpnet-base-v2
CLUSTERING_EMBED_BATCH_SIZE=64
CLUSTERING_EMBEDDINGS_CACHE=data/clustering/embeddings.npy
CLUSTERING_DOC_IDS_CACHE=data/clustering/doc_ids.json

# HDBSCAN parameters
# For small dev corpus testing:
# HDBSCAN_MIN_CLUSTER_SIZE=4
# HDBSCAN_MIN_SAMPLES=2
# CLUSTERING_MIN_CLUSTERS=2
HDBSCAN_MIN_CLUSTER_SIZE=10
HDBSCAN_MIN_SAMPLES=5
HDBSCAN_METRIC=cosine

# PCA Pre-processing for HDBSCAN (to prevent distance concentration)
CLUSTERING_USE_PCA=True
CLUSTERING_PCA_COMPONENTS=10

# Noise assignment mode: nearest | drop
CLUSTERING_NOISE_ASSIGNMENT=nearest

# Reweight cap fraction thresholds
CLUSTER_MIN_FRACTION=0.02
CLUSTER_MAX_FRACTION=0.15

# Per-cluster split ratios (must sum to 1.0)
SPLIT_DEV_RATIO=0.70
SPLIT_VAL_RATIO=0.20
SPLIT_SEALED_RATIO=0.10

# Output paths
CLUSTERING_OUTPUT_DIR=data/clustering
CLUSTERING_ASSIGNMENTS_PATH=data/clustering/cluster_assignments.jsonl
CLUSTERING_SPLITS_PATH=data/clustering/splits.json
CLUSTERING_MANIFEST_PATH=data/clustering/cluster_manifest.json
CLUSTERING_REPORT_PATH=logs/clustering/cluster_report.json
CLUSTERING_MIN_CLUSTERS=10


# ==============================================================================
# Step 5 — Teacher Benchmarking (S5)
# ==============================================================================

# Candidate teachers (comma-separated list)
BENCHMARK_TEACHERS=Qwen/Qwen3-1.7B
# Teacher generation backend: inherits RAD_TEACHER_BACKEND by default
# BENCHMARK_TEACHER_BACKEND=hf_local
BENCHMARK_TEACHER_BATCH_SIZE=4

# LLM reasoning judge configuration
BENCHMARK_JUDGE_BACKEND=api
BENCHMARK_JUDGE_MODEL=meta-llama/Llama-3-70b-instruct
# BENCHMARK_JUDGE_API_URL=
# BENCHMARK_JUDGE_API_KEY=
BENCHMARK_JUDGE_MAX_NEW_TOKENS=256

# Evaluation sampler limits
BENCHMARK_EVAL_SAMPLE_SIZE=200
BENCHMARK_MIN_EVAL_SAMPLES=10

# Human calibration & Cohen's Kappa checks
BENCHMARK_ENABLE_CALIBRATION=False
BENCHMARK_CALIBRATION_SIZE=200
# BENCHMARK_HUMAN_LABELS_PATH=

# Metric scoring thresholds
BENCHMARK_HALLUCINATION_NLI_THRESHOLD=0.5
BENCHMARK_CITATION_MIN_OVERLAP=0.30
BENCHMARK_NLI_MODEL=cross-encoder/nli-deberta-v3-small

# Outputs
BENCHMARKING_OUTPUT_DIR=data/benchmarking
BENCHMARKING_SCORES_PATH=data/benchmarking/scores.jsonl
BENCHMARKING_MANIFEST_PATH=data/benchmarking/benchmark_manifest.json
BENCHMARKING_CALIBRATION_LOG=logs/benchmarking/judge_calibration.jsonl
BENCHMARKING_INTER_RATER_LOG=logs/benchmarking/inter_rater_agreement.json
